fof(ax_coll1, axiom, ![A,B,C]:   ((collinear(A,B,C)) => collinear(A,C,B))).
fof(ax_coll2, axiom, ![A,B,C]:   ((collinear(A,B,C)) => collinear(B,C,A))).
fof(ax_coll3, axiom, ![A,B,C]:   ((~collinear(A,B,C)) => ~collinear(A,C,B))).
fof(ax_coll4, axiom, ![A,B,C]:   ((~collinear(A,B,C)) => ~collinear(B,C,A))).
fof(ax_coll5, axiom, ![A,B,C]:   ((~collinear(A,B,C)) => (A!=B))).
fof(ax_coll6, axiom, ![A,B,C,D]: ((~collinear(A,B,C) & collinear(A,B,D) & A!=D) => ~collinear(A,D,C))).
fof(ax_coll7, axiom, ![A,B,C,D]: ((~collinear(A,B,C) & between_strict(C,D,B)) => ~collinear(A,B,D))).


fof(ax_bet1, axiom, ![A,B,C]:     ((between_strict(A,B,C)) => collinear(A,B,C))).
fof(ax_bet2, axiom, ![A,B,C]:     ((between_strict(A,B,C)) => between_strict(C,B,A))).
fof(ax_bet3, axiom, ![A,B,C,D]:   ((between_strict(A,B,C) & between_strict(B,C,D) & (A!=D)) => between_strict(A,B,D))).
fof(ax_bet4, axiom, ![A,B,C,D]:   ((between_strict(A,B,C) & between_strict(B,C,D)) => between_strict(A,C,D))).

fof(ax_sides1, axiom, ![A,B,C,X]:   ((between_strict(A,X,B)) => opposite_sides(A,B,X,C))).
fof(ax_sides2, axiom, ![A,B,C,D,X]: ((between_strict(A,X,B) & collinear(C,X,D)) => opposite_sides(A,B,C,D))).
fof(ax_sides3, axiom, ![A,B,C,X]:   ((between_strict(A,X,B)) => same_side(X,B,A,C))).
fof(ax_sides4, axiom, ![A,B,C,D,X]: ((between_strict(A,X,B) & collinear(A,C,D)) => same_side(X,B,C,D))).
fof(ax_sides5, axiom, ![A,B,C,D,X]: ((between_strict(A,X,B) & between_strict(C,X,D)) => congruent_angles(A,X,C,B,X,D))).
fof(ax_sides6, axiom, ![A,B,C,D]:   ((same_side(B,C,D,A)) => same_side(B,C,A,D))).
fof(ax_sides7, axiom, ![A,B,C,D]:   ((same_side(B,C,D,A)) => same_side(C,B,A,D))).
fof(ax_sides9, axiom, ![A,B,C,D]:   ((opposite_sides(A,C,B,D)) => opposite_sides(C,A,B,D))).
fof(ax_sides10, axiom, ![A,B,C,D]:  ((opposite_sides(A,C,B,D)) => opposite_sides(A,C,D,B))).

%fof(ax_perp1, axiom, ![L1,L2]:      ((perpendicular_lines(L1,L2)) => perpendicular_lines(L2,L1))).
%fof(ax_perp2, axiom, ![L1,L2]:      ((perpendicular_lines(L1,L2)) => right_angle_lines(L1,L2))).
fof(ax_perp3, axiom, ![X,Y,Z,U]:    ((perpendicular_strict(X,Y,Z,U)) => perpendicular_strict(Y,X,Z,U))).
fof(ax_perp4, axiom, ![X,Y,Z,U]:    ((perpendicular_strict(X,Y,Z,U)) => perpendicular_strict(Z,U,X,Y))).
fof(ax_perp5, axiom, ![X,Y,Z]:      ((perpendicular_strict(X,Y,Y,Z)) => right_angle(X,Y,Z))).
fof(ax_perp6, axiom, ![X,Y,Z,U]:    ((perpendicular_strict(X,Y,Z,U) & collinear(Y,Z,U)) => right_angle(X,Y,Z))).

fof(ax_para1, axiom, ![X,Y,Z,U]:    ((parallel_strict(X,Y,Z,U)) => parallel_strict(Y,X,Z,U))).
fof(ax_para2, axiom, ![X,Y,Z,U]:    ((parallel_strict(X,Y,Z,U)) => parallel_strict(Z,U,X,Y))).
fof(ax_angle3, axiom, ![A,B,C]:     ((collinear(A,B,C) & A!=B & A!=C) => parallel_strict(A,B,A,C))).
fof(ax_angle4, axiom, ![A,B,C]:     ((collinear(A,B,C) & A!=B & B!=C) => parallel_strict(A,B,B,C))).

fof(ax_cong1, axiom, ![X,Y]: (cong(X,Y,X,Y))).
fof(ax_cong2, axiom, ![X,Y,Z,U]: ((cong(X,Y,Z,U)) => cong(Z,U,X,Y))).
fof(ax_cong3, axiom, ![X,Y,Z,U]: ((cong(X,Y,Z,U)) => cong(Y,X,Z,U))).

fof(ax_angle1, axiom, ![A,B,C]: ((congruent_angles(A,B,C,A,B,C)))).
fof(ax_angle2, axiom, ![A,B,C,D,E,F]: ((congruent_angles(A,B,C,D,E,F)) => (congruent_angles(D,E,F,A,B,C)))).
fof(ax_angle3, axiom, ![A,B,C,D,E,F,X,Y,Z]: ((congruent_angles(A,B,C,D,E,F) & congruent_angles(D,E,F,X,Y,Z)) => (congruent_angles(A,B,C,X,Y,Z)))).
fof(ax_angle4, axiom, ![A,B,C]: ((congruent_angles(A,B,C,C,B,A)))).
fof(ax_angle5, axiom, ![A,B,C,D]: ((between_strict(A,B,C) => congruent_angles(A,C,D,B,C,D)))).
fof(ax_angle6, axiom, ![A,B,C,D]: ((between_strict(A,B,C) & right_angle(D,B,C)) => right_angle(D,B,A))).
fof(ax_angle7, axiom, ![A,B,C,X,Y,Z]: ((right_angle(A,B,C) & congruent_angles(A,B,C,X,Y,Z)) => right_angle(X,Y,Z))).
fof(ax_angle8, axiom, ![A,B,C,X,Y,Z]: ((right_angle(A,B,C) & right_angle(X,Y,Z)) => congruent_angles(A,B,C,X,Y,Z))).
fof(ax_angle9, axiom, ![A,B,C,D]: ((opposite_sides(A,C,B,D) & parallel_strict(A,D,B,C)) => congruent_angles(A,D,B,D,B,C))).
fof(ax_angle10, axiom, ![A,B,C,D]: ((opposite_sides(A,C,B,D) & congruent_angles(A,D,B,D,B,C)) => parallel_strict(A,D,B,C))).              
fof(ax_angle11, axiom, ![A,B,C,D,E,F]: ((parallel_strict(A,B,C,D) & parallel_strict(C,D,E,F)) => parallel_strict(A,B,E,F))).
fof(ax_angle12, axiom, ![A,B,C,D]: ((parallel_strict(A,B,C,D) & parallel_strict(A,D,B,C)) => parallelogram(A,B,C,D))).

fof(ax_is_midpoint1, axiom, ![A,B,M]: ((is_midpoint(M,A,B)) => cong(A,M,M,B))).
fof(ax_is_midpoint2, axiom, ![A,B,M]: ((is_midpoint(M,A,B)) => between_strict(A,M,B))).
fof(ax_is_midpoint3, axiom, ![A,B,M]: ((between_strict(A,M,B) & cong(A,M,M,B)) => is_midpoint(M,A,B))).
fof(ax_is_midpoint4, axiom, ![A,B,C]: ((is_midpoint(C,A,B)) => is_midpoint(C,B,A))).
fof(ax_is_midpoint5, axiom, ![A,B,C,D,E]: ((is_midpoint(D,A,B) & is_midpoint(E,A,C)) => parallel_strict(B,C,D,E))).
fof(ax_is_midpoint6, axiom, ![A,B,C,D,E]: ((is_midpoint(D,A,B) & parallel_strict(B,C,D,E) & collinear(A,C,E)) => is_midpoint(E,A,C))).

fof(ax_triangle1, axiom, ![A,B,C]: ((~collinear(A,B,C)) => congruent_triangles(A,B,C,A,B,C))).
fof(ax_triangle2, axiom, ![A,B,C,D,E,F]: ((congruent_triangles(A,B,C,D,E,F)) => (congruent_triangles(D,E,F,A,B,C)))).
fof(ax_triangle3, axiom, ![A,B,C,D,E,F,X,Y,Z]: ((congruent_triangles(A,B,C,D,E,F) & congruent_triangles(D,E,F,X,Y,Z)) 
   => (congruent_triangles(A,B,C,X,Y,Z)))).

fof(ax_sas, axiom, ![A,B,C,D,E,F]: (
  (~collinear(A,B,C) & cong(A,B,D,E) & congruent_angles(A,B,C,D,E,F) & cong(B,C,E,F)) => congruent_triangles(A,B,C,D,E,F))).
fof(ax_sss, axiom, ![A,B,C,D,E,F]: (
  (~collinear(A,B,C) & cong(A,B,D,E) & cong(B,C,E,F) & cong(F,D,C,A)) => congruent_triangles(A,B,C,D,E,F))).
fof(ax_asa, axiom, ![A,B,C,D,E,F]: (
  (~collinear(A,B,C) & congruent_angles(C,A,B,F,D,E) & cong(A,B,D,E) & congruent_angles(A,B,C,D,E,F)) => congruent_triangles(A,B,C,D,E,F))).
fof(ax_aaa, axiom, ![A,B,C,D,E,F]: (
  (~collinear(A,B,C) & congruent_angles(A,B,C,D,E,F) & congruent_angles(B,C,A,E,F,D)) => congruent_angles(C,A,B,F,D,E))).
fof(ax_tc, axiom, ![A,B,C,D,E,F]: (
  (congruent_triangles(A,B,C,D,E,F)) => (cong(A,B,D,E)))).
fof(ax_tc, axiom, ![A,B,C,D,E,F]: (
  (congruent_triangles(A,B,C,D,E,F)) => (congruent_angles(A,B,C,D,E,F)))).

fof(ax_tt, axiom, ![X,Y,Z,U,V,W]: (congruent_triangles(X,Y,Z,U,V,W) => congruent_triangles(Z,X,Y,W,U,V))).

