\newcommand{\angleT}[3]{{#1} \, {#2} \, {#3}}
\newcommand{\betweenNonStrict}[3]{{#1} - {#2} - {#3}}
\newcommand{\betweenStrict}[3]{{#1} -/- {#2} -/- {#3}}
\newcommand{\congruentSegments}[2]{{#1} \mathbin{\equiv} {#2}}
\newcommand{\collinear}[3]{ \mathrm{Col} {#1} {#2} {#3} }
\newcommand{\congruentAngles}[6]{ \angleT{#1}{#2}{#3} \mathbin{\equiv} \angleT{#4}{#5}{#6}}
\newcommand{\rightAngle}[3]{RightAngle {#1} {#2} {#3} }
\newcommand{\perpendicular}[4]{ {#1}{#2} \mathbin{\perp} {#3}{#4} }
\newcommand{\perpendicularAt}[5]{{#1}{#2} \mathbin{\underset{#5}{\perp}} {#4}{#5}}
\newcommand{\parallelADG}[4]{{#1}{#2} \mathbin{\parallel} {#3}{#4}}
\newcommand{\lea}[6]{\angleT{#1}{#2}{#3} \leaa \angleT{#4}{#5}{#6}}
\newcommand{\lta}[6]{\angleT{#1}{#2}{#3} \ltaa \angleT{#4}{#5}{#6}}
\newcommand{\gea}[6]{\angleT{#1}{#2}{#3} \leaa \angleT{#4}{#5}{#6}}
\newcommand{\gta}[6]{\angleT{#1}{#2}{#3} \ltaa \angleT{#4}{#5}{#6}}
\newcommand{\insideAngle}[4]{InsideAngle {#1} {#2} {#3} {#4} }